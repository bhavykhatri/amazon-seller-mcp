# Amazon SP-API credentials for the MCP server. Copy to .env and fill in.
# Never commit .env.

SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SP_API_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SP_API_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Merchant Token (Seller ID) — Seller Central > Settings > Account Info > Merchant Token.
SP_API_SELLER_ID=A2XXXXXXXXXXXX

# Target marketplace + region. Defaults to India (EU endpoint).
# For other marketplaces set BOTH — see README "Marketplaces & regions".
SP_API_MARKETPLACE_ID=A21TJRUUN4KGV
SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
SP_API_TOKEN_ENDPOINT=https://api.amazon.com/auth/o2/token
